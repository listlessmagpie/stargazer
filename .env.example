# Copy to .env. Nothing here is required for the study, the forecasts or the local paper book.

# Alpaca paper account, the independent witness for the paper book. Free, email only, opened by
# Magpie herself at https://alpaca.markets (paper trading needs no money). Without these the
# local book is the record and alpaca_paper.py does nothing.
ALPACA_KEY=
ALPACA_SECRET=

# The oracles' tally, so record.json can show found / priced / bought counts. Same TALLY_KEY the
# orrery and Shuffle Up run with; ORRERY_URL is where the orrery answers on this machine.
TALLY_KEY=
ORRERY_URL=http://127.0.0.1:8000
