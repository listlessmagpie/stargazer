# CDP API keys (for on-chain swaps via Coinbase Developer Platform)
CDP_API_KEY_ID=...
CDP_API_KEY_SECRET=...

# Ampersend context name (from ampersend setup)
AMPERSEND_CONTEXT=ctx-61d1

# Paradox Box endpoint
PARADOX_BOX_URL=https://paradox-box-production.up.railway.app

# Agent behavior
SCORE_ACT=65
SCORE_EXIT=40
TRADE_FRACTION=0.25
MAX_POSITION_USD=5.00
CHECK_INTERVAL_HOURS=4

# Location for electional calculations (default: Portland, OR)
LOCATION_LAT=45.52
LOCATION_LON=-122.68
